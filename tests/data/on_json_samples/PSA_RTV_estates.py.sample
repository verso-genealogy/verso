    birth(9, Gender.MALE, 11, 13, father=person("Лука", "Фомин", status=MANILOV_SP_DVOROVY),
          mother=person("Анфиса", "Фомина")),
    birth(10, Gender.MALE, 12, 14, father=person("Лука", "Фомин", status=PEASANT_MALE),
          mother=person("Анфиса", "Фомина"), child=person("Фома")),
    birth(11, Gender.MALE, 13, 15, father=person("Фома", "Лукин", status=MANILOV_KF_PEASANT_MALE)),
    birth(12, Gender.MALE, 14, 16, father=person("Фома", "Лукин", status=MANILOV_KF_PEASANT_MALE,
                                                   residence="Собакевичево")),
    birth(13, Gender.MALE, 15, 17, mother=person("Анна", "Лукина",
                                                   status="крестьянка помещика Кузьмы Филипповича Манилова")),
    birth(14, Gender.MALE, 16, 18, father=person("Фома", "Лукин", status=KAZENNYJ_PEASANT_MALE, residence="Неелово")),
    birth(15, Gender.MALE, 17, 19, father=person("Петр", "Лукин"),
