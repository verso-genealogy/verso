    birth(17, Gender.MALE, 4, 6, child=person("Фома", status=MERCHANT)),
    birth(3, Gender.MALE, 5, 7, child=person("Фома", status=BUDNY_PEASANT)),
    birth(4, Gender.MALE, 6, 8, father=person("Семен", "Лукин"),
