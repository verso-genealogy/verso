# Invented: a status against the household's (PSA001-PSA003) and against where its bearer lives (RTV001, RTV002),
# a full patronymic (PAF001) and a roll's two ages (CAI002). PSA: a parent and a child of two estates, a husband and
# a wife (the clergy is compared there), a statusless side on the book's default (PSA002), a newborn styled
# by an adult role (PSA003, with and without a child form to offer), a status in free text, a death's father, mother
# and husband, a wedding's parents of the groom and of the bride; quiet: a child whose status derives from the
# parent. RTV001: a landlord's peasant or a state peasant living elsewhere, in words and by constant, by the book's
# residence, by the parent's, by the census village; quiet: a godparent, a residence stated at a wedding. RTV002: the
# село of the owners and the state's деревня of a parish, a status written and given by the book, a soldier. PAF001:
# a patronymic of the full form in a book before and after 1918, on a card and on a list. CAI002: the gap of the
# revision, in numbers, in text, in a comment; quiet: the two columns alike, a departed or hidden member, a gap
# within a year.
from corpus.statuses import (
    GOLOVLEV_PEASANT, MANILOV_KF_PEASANT_MALE, MANILOV_KF_PEASANT_SON, MANILOV_PS_PEASANT_FEMALE,
    MANILOV_PS_PEASANT_MALE, MANILOV_SP_DVOROVY, NOZDREV_PEASANT, NOZDREV_PEASANT_FEMALE)
from verso.ru.dsl import (
    CensusRole, Gender, Month, RecordDefaults, Relationship, birth, birth_records, census_records, death,
    death_records, external_source_records, household, listed_person, marriage, marriage_records, member,
    name_list_records, person, relative, wwi_record)
from verso.ru.dsl.statuses import (
    BUDNY_PEASANT, KAZENNYJ_PEASANT_FEMALE, KAZENNYJ_PEASANT_MALE, MERCHANT, MESHCHANIN_FEMALE, PEASANT_FEMALE,
    PEASANT_MALE, PRIEST,
    STATE_PEASANT_MALE, YASAK_PEASANT_FEMALE, YASAK_PEASANT_MALE, YASAK_PEASANT_SON)

