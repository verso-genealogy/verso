# RTV002 in a roll: the census book's RecordDefaults gives a member with no status the owners' estate (and a status
# of its own stays as written).
parish_census = census_records(
    "Госархив Примерской области", "21", "3", "211", "Глуповы Горы", 1858,
    household("1",
              member(1, person("Иван", "Петров", residence="Горелово"), CensusRole.HEAD, None, 30),
              member(2, person("Анна", "Петрова", residence="Горелово"), CensusRole.WIFE, 1, 28),
              member(3, person("Лука", "Иванов", residence="Горелово", status=PEASANT_MALE), CensusRole.SON, 1, 5)),
    defaults=RecordDefaults(status_male=NOZDREV_PEASANT, status_female=NOZDREV_PEASANT_FEMALE))

# PAF001: a book before 1918 and one after, an old patronymic given as patr_old, and a card and a list.
patronymics = birth_records(
    "Госархив Примерской области", "21", "3", "208", "Горюхино", "Никольская", 1917,
    birth(1, Gender.MALE, 3, 5, father=person("Иван", "Петрович", status=PEASANT_MALE),
          mother=person("Анна", "Петровна", status=PEASANT_FEMALE), child=person("Лука"),
          god_parent1=person("Фома", "Лукич"), god_parent2=person("Анфиса", patr_old="Лукинична")))
