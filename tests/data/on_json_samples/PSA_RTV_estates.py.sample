    birth(5, Gender.MALE, 7, 9, mother=person("Анна", "Лукина"),
          child=person("Фома", status=MANILOV_KF_PEASANT_SON)),
    birth(6, Gender.MALE, 8, 10, father=person("Иван", "Лукин", status="крестьянин помещика Саввы Пантелеевича Манилова"),
          child=person("Петр")),
    birth(7, Gender.MALE, 9, 11, father=person("Иван", "Лукин", status="крестьянин помещика Саввы Пантелеевича Манилова"),
          child=person("Петр", status=MANILOV_KF_PEASANT_SON)),
    birth(8, Gender.MALE, 10, 12, father=person("Лука", "Фомин", status=PRIEST),
