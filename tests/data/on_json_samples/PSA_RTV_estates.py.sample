    birth(16, Gender.MALE, 18, 20, father=person("Петр", "Лукин", status=KAZENNYJ_PEASANT_MALE),
          mother=person("Анна", "Лукина", status=PEASANT_FEMALE),
          relatives=[relative(person("Фома", status=STATE_PEASANT_MALE), Relationship.FATHER, "отец")]),
    defaults=RecordDefaults(residence="Горюхино", status_male=YASAK_PEASANT_MALE, status_female=YASAK_PEASANT_FEMALE))

