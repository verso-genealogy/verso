# Invented: the links of a household's members (CPL003-CPL010).
from verso.ru.dsl import CONFESSION_LIST, CensusRole, census_records, household, member, person

links = census_records(
    "ГА Глуповской области", "10", "4", "4048", "Маниловка", 1858,
    # CPL003: a daughter-in-law of the head with no deceased son and no hidden husband.
    household("1",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=1, age=30),
              member(3, person("Анна"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=28)),
    # ... silent: exactly one deceased son; and a hidden husband; and a secondary marriage either way.
    household("2",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=1, departure_reason="умер"),
              member(3, person("Анна"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=28)),
    household("3",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Анна"), CensusRole.DAUGHTER_IN_LAW, age=28),
              member(-1, person("Иванъ"), None, ref_member=2, parent_member=1, hidden=True),
              member(3, person("Марья"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=26,
                     secondary_role=CensusRole.WIFE, secondary_ref_member=4),
              member(4, person("Семенъ"), CensusRole.SON, ref_member=1, age=27),
              member(5, person("Дарья"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=25),
              member(6, person("Петръ"), CensusRole.SON, ref_member=1, age=26,
                     secondary_role=CensusRole.HUSBAND, secondary_ref_member=5)),
    # ... two deceased sons: still no pairing.
    household("4",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=1, departure_reason="умер"),
              member(3, person("Семенъ"), CensusRole.SON, departure_reason="умер"),
              member(4, person("Анна"), CensusRole.DAUGHTER_IN_LAW, age=28, hidden=True),
              member(5, person("Дарья"), CensusRole.DAUGHTER_IN_LAW, age=25)),
    # CPL004: a wife whose parent is her husband, his ancestor, his sibling; and her own father.
    household("5",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=1, age=30),
              member(3, person("Анна"), CensusRole.WIFE, ref_member=2, age=28, parent_member=2),
              member(4, person("Семенъ"), CensusRole.GRANDSON, ref_member=2, age=5, parent_member=2),
              member(5, person("Дарья"), CensusRole.DAUGHTER_IN_LAW, ref_member=4, age=26, parent_member=2),
              member(6, person("Петръ"), CensusRole.SON, ref_member=1, age=25),
              member(7, person("Марья"), CensusRole.WIFE, ref_member=2, age=24, parent_member=6),
              member(8, person("Иванъ"), CensusRole.UNCLE, ref_member=1, age=55),
              member(9, person("Агафья"), CensusRole.WIFE, ref_member=6, age=22, parent_member=8),
              member(10, person("Никифоръ"), CensusRole.BROTHER, ref_member=1, age=50),
              member(11, person("Анна"), CensusRole.DAUGHTER_IN_LAW, age=26, parent_member=10)),
    # CPL005, CPL006: a hidden member that connects nobody; a recorded member referring to a hidden one.
    household("6",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(-1, person("Иванъ"), CensusRole.BROTHER, hidden=True),
              member(-2, person("Дарья"), CensusRole.SISTER, hidden=True, ref_member=1),
              member(-3, person("Марья"), CensusRole.WIFE, hidden=True),
              member(-4, person("Семенъ"), CensusRole.FATHER, hidden=True),
              member(-5, person("Анна"), CensusRole.SISTER, hidden=True, ref_member=-4),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=-4, age=30),
              member(3, person("Дарья"), CensusRole.DAUGHTER, ref_member=-5, age=20),
              member(4, person("Агафья"), CensusRole.DAUGHTER, parent_member=-4, age=20)),
    # CPL007, CPL008: what a reference means.
    household("7",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Анна"), None, ref_member=1, age=50),
              member(3, person("Марья"), None, ref_member=1, age=40, spouse_member=1),
              member(4, person("Дарья"), None, ref_member=1, age=40, parent_member=1),
              member(5, person("Агафья"), None, ref_member=1, age=40, secondary_role=CensusRole.WIFE,
                     secondary_ref_member=1),
              member(6, person("Ѳома"), CensusRole.SON, ref_member=1, age=30, secondary_role=CensusRole.HUSBAND,
                     secondary_ref_member=1),
              member(7, person("Семенъ"), CensusRole.SON, ref_member=1, age=30, secondary_role=CensusRole.BROTHER,
                     secondary_ref_member=1),
              member(8, person("Петръ"), CensusRole.SON, ref_member=1, age=30, secondary_role=CensusRole.BROTHER,
                     secondary_ref_member=2),
              member(9, person("Ѳекла"), ref_member=1, age=50)),
    # CPL009, CPL010: a number the household lacks; a number used twice (the later wins).
    household("8",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=99, age=30),
              member(2, person("Семенъ"), CensusRole.SON, ref_member=1, parent_member=16, age=28,
                     secondary_role=CensusRole.BROTHER, secondary_ref_member=17),
              member(3, person("Анна"), CensusRole.WIFE, ref_member=2, age=26),
              member(3, person("Дарья"), CensusRole.DAUGHTER, ref_member=2, age=5),
              member(3, person("Марья"), CensusRole.DAUGHTER, ref_member=2, age=3),
              member(-1, person("Иванъ"), CensusRole.FATHER, hidden=True),
              member(-1, person("Петръ"), CensusRole.UNCLE, hidden=True),
              member(4, person("Агафья"), CensusRole.DAUGHTER, ref_member=-1, parent_member=-7, age=1)),
    # CPL003: the head is the first number that was given, whoever ends up holding it.
    household("9",
              member(5, person("Ѳома"), CensusRole.SON, age=30),
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(5, person("Семенъ"), CensusRole.HEAD, age=50),
              member(2, person("Анна"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=28)),
    reviewed=False)

# A confession list is the same machinery.
confession = census_records(
    "ГА Глуповской области", "10", "4", "4049", "Маниловка", 1858,
    household("1",
              member(1, person("Лука", "Ѳоминъ", "Примеровъ"), CensusRole.HEAD, age=60),
              member(2, person("Анна"), CensusRole.DAUGHTER_IN_LAW, ref_member=1, age=28),
              member(2, person("Ѳома"), CensusRole.SON, ref_member=7, age=30),
              member(-1, person("Марья"), CensusRole.SISTER, hidden=True)),
    **CONFESSION_LIST)
