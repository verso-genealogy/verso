# Invented: what a roll member or a death's relative writes that LOOKS like what the family gives, and is not —
# removing it changes what the generator makes, so neither reader calls it redundant (CRD001, CRD002, CRD004, DRA002).
# A daughter who writes a current surname of her own: the generator then derives no maiden name, so the maiden name she
# writes is hers alone. A member who names himself, and one who names a member listed AFTER him that derives its
# surname: the generator makes one pass in member order and gives neither anything. A death whose relatives' residences
# disagree: the household's residence is the FIRST relative's that states one, so the relative who repeats the
# deceased's would be given another relative's village.
from verso.ru.dsl import CensusRole, Gender, Relationship, census_records, death, death_records, household, member, person, relative

roll = census_records(
    "ГА Глуповской области", "10", "4", "4062", "Маниловка", 1858,
    household("1",
              member(1, person("Петръ", "Лукинъ", "Образцовъ"), CensusRole.HEAD, age=60),
              member(2, person("Анна", "Петрова", last_name_orig="Другова", birth_last_name_modern_orth="Образцова"),
                     CensusRole.DAUGHTER, 1, age=30, comment="вдова, возвратилась в отцовский дом")),
    household("2",
              member(1, person("Петръ", "Лукинъ", "Образцовъ"), CensusRole.HEAD, age=60),
              member(2, person("Никифоръ", last_name_modern_orth="Образцов"), CensusRole.GRANDSON, 2, age=6),
              member(3, person("Семенъ", "Петровъ", "Образцовъ"), CensusRole.SON, 3, age=16)),
    household("3",
              member(1, person("Петръ", "Лукинъ", "Образцовъ"), CensusRole.HEAD, age=60),
              member(2, person("Никифоръ", last_name_orig="Образцовъ"), CensusRole.GRANDSON, 4, age=6),
              member(3, person("Марья", birth_last_name_modern_orth="Образцова"), CensusRole.GRANDDAUGHTER, 4, age=4),
              member(4, person("Иванъ", "Петровъ"), CensusRole.SON, 1, age=30)))

deaths = death_records(
    "ГА Глуповской области", "10", "4", "4065", "Маниловка", "Церковь", 1857,
    death(1, Gender.MALE, 3, 4, deceased=person("Лука", residence="Ротозеево"),
          relatives=[relative(person("Петръ", residence="Ротозеево"), Relationship.FATHER),
                     relative(person("Марья", residence="Заманиловка"), Relationship.MOTHER)]),
    death(2, Gender.MALE, 5, 6, deceased=person("Иванъ", residence="Ротозеево"),
          relatives=[relative(person("Петръ", residence="Заманиловка"), Relationship.FATHER),
                     relative(person("Марья", residence="Ротозеево"), Relationship.MOTHER)]),
    death(3, Gender.FEMALE, 7, 8, deceased=person("Анна", residence="Ротозеево"),
          relatives=[relative(person("Петръ", residence="Ротозеево"), Relationship.HUSBAND),
                     relative(person("Иванъ", residence="Ротозеево"), Relationship.SON),
                     relative(person("Марья", residence="Заманиловка"), Relationship.DAUGHTER)]))
