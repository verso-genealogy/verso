from verso.ru.dsl import CensusRole, census_records, household, member
from verso.ru.dsl import person
rs = census_records(
    "ГАВО", "431", "1", "100", "Нижняя Яичница", 1897,
    household(
        member(1, person("Петр", "Миронов", "Индюшев"), CensusRole.HEAD, age=50),
        member(2, person("Сергей", "Иванов", "Индюшев"), CensusRole.GRANDSON, age=5),
    ),
)
