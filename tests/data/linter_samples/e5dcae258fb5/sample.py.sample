from verso.ru.dsl import CensusRole, census_records, household, member
from verso.ru.dsl import person
rs = census_records(
    "ГАВО", "431", "1", "100", "Нижняя Яичница", 1897,
    household(
        member(1, person("Алексей", "Матвеев", "Индюшев"), CensusRole.HEAD, age=47),
        member(5, person("Иван", "Петров"), CensusRole.GRANDSON, ref_member=-1),
        member(-1, person("Петр"), CensusRole.SON, ref_member=1, hidden=True),
    ),
)
