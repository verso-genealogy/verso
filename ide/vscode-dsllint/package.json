{
  "name": "verso-dsllint",
  "displayName": "Verso DSL Linter",
  "description": "Lint and highlight genealogy DSL Python files — validates person() calls, gender constraints, and names inline.",
  "version": "0.5.0",
  "publisher": "verso-genealogy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/verso-genealogy/verso"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Linters"],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Genealogy DSL Linter",
      "properties": {
        "dsllint.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter"
        },
        "dsllint.lintOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run linter automatically on file save"
        },
        "dsllint.lintOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run linter automatically when opening a DSL file"
        }
      }
    },
    "commands": [
      {
        "command": "dsllint.lint",
        "title": "DSL Lint: Run Linter on Current File"
      },
      {
        "command": "dsllint.lintAll",
        "title": "DSL Lint: Run Linter on All DSL Files in Workspace"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.python.genealogy-dsl",
        "path": "./syntaxes/genealogy-dsl.injection.tmLanguage.json",
        "injectTo": ["source.python"]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "test": "mocha out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.80.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
